# Copy to .env (gitignored) and adjust. Values here are placeholders/safe defaults.
# Secrets are NOT configured here: they live in ./secrets (see scripts/init-secrets.sh).

# --- WebDAV over HTTPS (Caddy) ---
# DNS name clients use. For a VPN-only/local setup keep CADDY_TLS=internal and trust
# Caddy's root CA (docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt .).
DAV_DOMAIN=dav.example.com
# "internal" (Caddy's local CA) or an ACME e-mail address (needs public 80/443 + DNS).
CADDY_TLS=internal

# --- Host bindings (keep loopback until public exposure is approved) ---
SFTP_BIND_ADDRESS=127.0.0.1
SFTP_PORT=2022
HTTP_BIND_ADDRESS=127.0.0.1
HTTPS_BIND_ADDRESS=127.0.0.1
HTTPS_PORT=443
HTTP_PORT=80
# SFTPGo WebAdmin/REST API and worker diagnostics are always loopback-only.
SFTPGO_ADMIN_HOST_PORT=8080
WORKER_ADMIN_HOST_PORT=8090
# Internal network shared by Caddy, SFTPGo and the worker. Must not overlap the
# WireGuard subnet or other networks on the host (check the preflight output).
KFGW_BACKEND_SUBNET=172.30.200.0/24

# --- Staging storage ---
# Named volume by default; on the VPS prefer an absolute path on a dedicated
# filesystem (e.g. /srv/kfgw-staging) so a full staging area cannot fill "/".
STAGING_SOURCE=staging

# --- KatFile ---
KATFILE_API_BASE_URL=https://katfile.biz/
KATFILE_UPLOAD_MODE=fixed
# Parent folder for per-user root folders (0 = account root).
KATFILE_USERS_PARENT_FOLDER_ID=0

# --- Worker ---
# serve | record-hooks (diagnostics: record SFTPGo hooks, archive nothing)
WORKER_COMMAND=serve
WORKER_MAX_ACTIVE_KATFILE_UPLOADS=1
WORKER_RETRY_MAX=8
WORKER_RETENTION_HOURS=24
# Free-space reserve kept on the staging filesystem (4 GiB). An upload is admitted
# only if free - reservations >= reserve + expected size.
WORKER_MIN_FREE_BYTES=4294967296
# Assumed size for uploads whose length is unknown in advance (SFTP): 1 GiB.
WORKER_UNKNOWN_UPLOAD_RESERVATION_BYTES=1073741824
RUST_LOG=info
